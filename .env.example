# ============================================================
# KISSOWRA'S STORES — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (generate a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Database (SQLite path — relative to backend/)
DATABASE_PATH=./data/kissowra.db

# Email (Nodemailer — use Gmail App Password or SMTP relay)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Store owner notification email
OWNER_EMAIL=owner@kissowrastores.com

# Payment — Paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Payment — Flutterwave (alternative)
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here

# Active payment provider: "paystack" or "flutterwave"
PAYMENT_PROVIDER=paystack

# WhatsApp (international format, no + or spaces)
WHATSAPP_NUMBER=2348000000000

# Frontend URL (for CORS and payment callbacks)
FRONTEND_URL=http://localhost:3000

# Admin default credentials (only used during first-run DB seed)
ADMIN_EMAIL=admin@kissowrastores.com
ADMIN_PASSWORD=Admin@Kissowra2024
